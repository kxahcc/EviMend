{
  "schema_version": 1,
  "profile": "windows-local-development",
  "enforcement_status": "offline_agent_guarded",
  "paths": {
    "managed_root": ".dfx-local",
    "export_root": "runs/exports",
    "harmony_root": "DFX-HarmonyOS"
  },
  "limits": {
    "max_concurrent_runs": 1,
    "max_active_processes": 32,
    "cpu_rate_percent": 20,
    "job_memory_cap_bytes": 2147483648,
    "job_memory_fraction_of_physical": 0.25,
    "min_free_memory_bytes": 2147483648,
    "managed_disk_budget_bytes": 34359738368,
    "max_export_package_bytes": 268435456,
    "min_free_disk_bytes": 10737418240,
    "min_free_disk_fraction": 0.10,
    "monitor_interval_seconds": 2,
    "default_wall_timeout_seconds": 1800,
    "stop_grace_seconds": 10,
    "max_log_file_bytes": 33554432,
    "max_run_log_bytes": 104857600,
    "max_download_concurrency": 2,
    "max_build_concurrency": 1
  },
  "execution": {
    "application_target": "local",
    "require_windows_job_limits": true,
    "allow_background_services": false,
    "allow_local_model_weights": false,
    "allow_local_harmony_sdk": true,
    "allow_model_experiments": true,
    "allow_application_experiments": true
  },
  "cleanup": {
    "default_dry_run": true,
    "require_owner_match": true,
    "refuse_external_reparse_points": true,
    "require_quiescent_root": true,
    "require_export_or_explicit_discard": true
  }
}
